generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  PURCHASE_RETURN
  SALE_RETURN
  ADJUSTMENT
  DAMAGE
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(100)
  email        String  @unique @db.VarChar(100)
  phone        String? @unique @db.VarChar(20)
  passwordHash String  @db.VarChar(255)
  role         Role    @default(STAFF)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Audit Back-relations for transactions
  createdStockMovements StockMovement[] @relation("StockMovementCreatedBy")
  updatedStockMovements StockMovement[] @relation("StockMovementUpdatedBy")

  userRoles UserRole[]

  @@map("users")
}

model VehicleCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String
  code String @unique

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands VehicleBrand[]

  @@map("vehicle_categories")
}

model VehicleBrand {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  name       String
  code       String

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category VehicleCategory @relation(fields: [categoryId], references: [id])
  models   VehicleModel[]

  @@unique([categoryId, name])
  @@map("vehicle_brands")
}

model VehicleModel {
  id      String @id @default(uuid()) @db.Uuid
  brandId String @db.Uuid
  name    String
  code    String

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    VehicleBrand     @relation(fields: [brandId], references: [id])
  variants VehicleVariant[]

  @@unique([brandId, name])
  @@map("vehicle_models")
}

model VehicleVariant {
  id       String @id @default(uuid()) @db.Uuid
  modelId  String @db.Uuid
  name     String
  code     String
  yearFrom Int?
  yearTo   Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model          VehicleModel   @relation(fields: [modelId], references: [id])
  vehicleGlasses VehicleGlass[]

  @@unique([modelId, name])
  @@index([modelId])
  @@map("vehicle_variants")
}

model Product {
  id          String @id @default(uuid()) @db.Uuid
  sku         String @unique
  name        String
  productType String @default("GLASS")

  hsnCode String?
  unit    String  @default("PCS")

  purchasePrice Decimal @db.Decimal(12, 2)
  sellingPrice  Decimal @db.Decimal(12, 2)
  gstRate       Decimal @db.Decimal(5, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleGlasses    VehicleGlass[]
  inventory         Inventory?
  stockMovements    StockMovement[]
  purchaseItems     PurchaseItem[]
  salesInvoiceItems SalesInvoiceItem[]

  @@index([name])
  @@index([productType])
  @@map("products")
}

model VehicleGlass {
  id            String @id @default(uuid()) @db.Uuid
  variantId     String @db.Uuid
  productId     String @db.Uuid
  glassPosition String

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant VehicleVariant @relation(fields: [variantId], references: [id])
  product Product        @relation(fields: [productId], references: [id])

  @@unique([variantId, productId, glassPosition])
  @@index([variantId])
  @@index([productId])
  @@index([glassPosition])
  @@map("vehicle_glasses")
}

model Inventory {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @unique @db.Uuid
  quantity         Decimal @default(0) @db.Decimal(12, 2)
  reservedQuantity Decimal @default(0) @db.Decimal(12, 2)
  minStockLevel    Decimal @default(0) @db.Decimal(12, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@map("inventory")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @db.Uuid
  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?           @db.Uuid
  remarks       String?

  active      Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("StockMovementUpdatedBy", fields: [updatedById], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
  @@map("stock_movements")
}

// ------------------------------------------------------
// 1. PURCHASE MANAGEMENT
// ------------------------------------------------------

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  gstin     String?
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases        Purchase[]
  supplierPayments SupplierPayment[]

  @@map("suppliers")
}

enum DocumentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model Purchase {
  id            String         @id @default(uuid()) @db.Uuid
  supplierId    String         @db.Uuid
  invoiceNumber String? // Supplier's invoice number
  purchaseDate  DateTime
  status        DocumentStatus @default(DRAFT)
  paymentStatus PaymentStatus  @default(UNPAID)

  subTotal   Decimal @default(0) @db.Decimal(12, 2)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier          @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]
  payments SupplierPayment[]

  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid()) @db.Uuid
  purchaseId String  @db.Uuid
  productId  String  @db.Uuid
  quantity   Decimal @db.Decimal(12, 2)
  unitPrice  Decimal @db.Decimal(12, 2)
  hsnCode    String?
  gstRate    Decimal @db.Decimal(5, 2)
  taxAmount  Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model SupplierPayment {
  id            String   @id @default(uuid()) @db.Uuid
  supplierId    String   @db.Uuid
  purchaseId    String?  @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now())
  paymentMethod String
  referenceNo   String?

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  @@map("supplier_payments")
}

// ------------------------------------------------------
// 2. SALES AND POS BILLING
// ------------------------------------------------------

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?
  email     String?
  gstin     String?
  address   String?
  stateCode String? // For CGST/SGST vs IGST calculation
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices SalesInvoice[]
  payments Payment[]
  claims   InsuranceClaim[]

  @@map("customers")
}

model SalesInvoice {
  id            String         @id @default(uuid()) @db.Uuid
  customerId    String?        @db.Uuid // Optional for walk-in
  invoiceNumber String         @unique
  invoiceDate   DateTime       @default(now())
  status        DocumentStatus @default(DRAFT)
  paymentStatus PaymentStatus  @default(UNPAID)

  subTotal   Decimal @default(0) @db.Decimal(12, 2)
  taxAmount  Decimal @default(0) @db.Decimal(12, 2) // Total GST
  cgstAmount Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount Decimal @default(0) @db.Decimal(12, 2)
  igstAmount Decimal @default(0) @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @default(0) @db.Decimal(12, 2)
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer       Customer?          @relation(fields: [customerId], references: [id])
  items          SalesInvoiceItem[]
  payments       Payment[]
  insuranceClaim InsuranceClaim?

  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  productId String @db.Uuid

  // Snapshots at time of sale
  productName String
  sku         String
  hsnCode     String?

  quantity     Decimal @db.Decimal(12, 2)
  unitPrice    Decimal @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  taxableValue Decimal @db.Decimal(12, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(12, 2)
  igstAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(12, 2)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@map("sales_invoice_items")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String?  @db.Uuid
  invoiceId     String?  @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now())
  paymentMethod String // CASH, UPI, CARD, BANK
  referenceNo   String?

  customer Customer?     @relation(fields: [customerId], references: [id])
  invoice  SalesInvoice? @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

// ------------------------------------------------------
// 3. INSURANCE BILLING & CLAIMS
// ------------------------------------------------------

model InsuranceCompany {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  contact   String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims InsuranceClaim[]

  @@map("insurance_companies")
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  SETTLED
  CLOSED
}

model InsuranceClaim {
  id         String  @id @default(uuid()) @db.Uuid
  companyId  String  @db.Uuid
  customerId String  @db.Uuid
  invoiceId  String? @unique @db.Uuid

  vehicleRegNo     String
  policyNumber     String
  claimReferenceNo String?
  incidentDate     DateTime?
  claimDate        DateTime  @default(now())

  claimedAmount   Decimal @default(0) @db.Decimal(12, 2)
  approvedAmount  Decimal @default(0) @db.Decimal(12, 2)
  customerPayable Decimal @default(0) @db.Decimal(12, 2)
  amountReceived  Decimal @default(0) @db.Decimal(12, 2)

  status  ClaimStatus @default(DRAFT)
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  InsuranceCompany @relation(fields: [companyId], references: [id])
  customer Customer         @relation(fields: [customerId], references: [id])
  invoice  SalesInvoice?    @relation(fields: [invoiceId], references: [id])

  @@map("insurance_claims")
}

// ------------------------------------------------------
// 4. DYNAMIC ROLES AND PERMISSIONS
// ------------------------------------------------------

model RoleDef {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("role_defs")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // e.g., 'sales.create'
  module      String // e.g., 'sales'
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       RoleDef    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ------------------------------------------------------
// 5. BUSINESS PROFILE AND SETTINGS
// ------------------------------------------------------

model BusinessProfile {
  id           String  @id @default(uuid()) @db.Uuid
  legalName    String
  tradeName    String?
  gstin        String?
  address      String?
  stateCode    String?
  pinCode      String?
  phone        String?
  email        String?
  invoiceNotes String?

  updatedAt DateTime @updatedAt

  @@map("business_profile")
}

model InvoiceSequence {
  id            String @id @default(uuid()) @db.Uuid
  documentType  String // e.g., "SALES", "PURCHASE_RETURN"
  prefix        String
  currentValue  Int    @default(0)
  financialYear String // e.g., "2026-27"

  @@unique([documentType, financialYear])
  @@map("invoice_sequences")
}
